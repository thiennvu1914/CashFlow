// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth tables.
//
// Started from `npx @better-auth/cli@latest generate`, then reconciled by hand
// against the installed better-auth 1.7.2's own table definitions
// (`getAuthTables` in @better-auth/core/db). The published CLI is 1.4.21 and
// lags the library, so its output was missing `Account.issuer` and the
// `(issuer, accountId)` unique index.
//
// better-auth leaves an additional field's `required` unset, so the CLI emitted
// the five CashFlow user fields as nullable. CashFlow deliberately makes those
// five columns NOT NULL with database defaults instead: the app treats them as
// always-present settings, and a database default keeps that true for every
// writer, not just Better Auth's own create path.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // CashFlow's additional user fields. Better Auth applies these same defaults
  // when it creates the row; the database defaults cover every other writer.
  // All five are `input: false` in `lib/auth/create-auth.ts`, so no client
  // request body can set them. The four profile values below are the DB-level
  // copy of `USER_FIELD_DEFAULTS` in `lib/auth/user-defaults.ts` — the single
  // source the application code shares; keep them in step.
  baseCurrency  String    @default("VND")
  locale        String    @default("vi")
  theme         String    @default("light")
  timezone      String    @default("Asia/Ho_Chi_Minh")
  isDemo        Boolean   @default(false)
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// Better Auth's own OAuth / credential-linking table — NOT the financial
/// account concept. Phase 2 introduces `FinancialAccount` precisely to avoid
/// colliding with this name (§3, §4.3 of the spec). Do not rename this model.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// CashFlow domain tables.
//
// A back-relation array is added to a model only in the same commit that
// introduces the model referencing it, which keeps every migration valid on its
// own. `AccountType.accounts` arrived with `FinancialAccount`, and
// `Category.transactions` / `FinancialAccount.transactions` with `Transaction`.
//
// The `@@unique([userId, id])` on each is what lets later models carry a
// composite `(userId, <fk>)` foreign key, so a row can never reference another
// user's AccountType or Category (§4.12 of the spec).
// ---------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryType {
  INCOME
  EXPENSE
}

model AccountType {
  id        String       @id @default(cuid())
  userId    String
  name      String
  icon      String?
  isDefault Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  accounts FinancialAccount[]

  @@unique([userId, id])
  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  isDefault Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  transactions Transaction[]
  budgets      Budget[]
  reminders    RecurringReminder[]

  @@unique([userId, id])
  @@index([userId])
}

enum Currency {
  VND
  USD
}

model FinancialAccount {
  id             String       @id @default(cuid())
  userId         String
  name           String
  accountTypeId  String
  initialBalance Decimal      @db.Decimal(18, 2)
  currency       Currency
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  accountType   AccountType         @relation(fields: [userId, accountTypeId], references: [userId, id])
  transactions  Transaction[]
  transfersFrom Transfer[]          @relation("TransferFromAccount")
  transfersTo   Transfer[]          @relation("TransferToAccount")
  reminders     RecurringReminder[]

  @@unique([userId, id])
  @@index([userId])
}

/// FX rate cache (§6.2). Global, not per-user: a USD/VND rate for a given day
/// is the same fact for everyone, so this table carries no `userId` and is the
/// one CashFlow table not scoped by `requireUser()`.
///
/// `effectiveDate` is always the UTC start-of-day the rate applies to, which is
/// what makes `(base, quote, effectiveDate)` a natural key: one cached row per
/// pair per day, upserted when a fresher fetch for the same day arrives.
/// Historical rows are kept permanently — a past day's rate never changes.
model ExchangeRate {
  id            String   @id @default(cuid())
  base          Currency
  quote         Currency
  rate          Decimal  @db.Decimal(18, 6)
  effectiveDate DateTime
  fetchedAt     DateTime
  source        String

  @@unique([base, quote, effectiveDate])
  @@index([base, quote, effectiveDate(sort: Desc)])
}

enum TransactionType {
  INCOME
  EXPENSE
  CASH_IN
  CASH_OUT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
}

/// A single money movement (§4.4). `amount` is always >= 0 — the direction is
/// carried by `type` alone, never by the sign — and `currency` is always a copy
/// of the owning account's currency, never client-supplied.
///
/// The four `fx*` columns are the immutable FX snapshot: the usable USD/VND
/// rate at the moment this transaction's economic content was recorded, taken
/// only from `getUsableCurrentRate`. The pair is always USD/VND regardless of
/// the account currency, so any later report can restate the row in either
/// currency using the rate that actually applied.
///
/// The two timestamps answer two different questions and are both kept:
/// `fxRateEffectiveAt` is *when the rate applies* — the UTC start of the day
/// it was published for, which is the `ExchangeRate` cache's natural key — and
/// `fxRateFetchedAt` is *when we retrieved it*. They can be a day or more
/// apart: on the fallback path both are the original cached row's own values,
/// never "now", so a snapshot recorded during an outage still says honestly
/// which day's rate it used and when that rate was obtained. `fxRateSource`
/// carries the `cache-fallback:` prefix in exactly that case.
///
/// The `category` relation is optional while still being a composite FK: under
/// Postgres's default MATCH SIMPLE semantics a NULL in any column of a
/// composite FK exempts the row from the constraint check, so CASH_IN /
/// CASH_OUT / ADJUSTMENT_* rows with no category are unaffected.
model Transaction {
  id                String          @id @default(cuid())
  userId            String
  accountId         String
  categoryId        String?
  type              TransactionType
  /// >= 0 is also enforced by a database CHECK constraint
  /// (`Transaction_amount_nonnegative`), written by hand in the
  /// `add_transfer` migration — Prisma's schema language has no CHECK syntax,
  /// so the constraint lives in SQL and this comment is its only trace here.
  amount            Decimal         @db.Decimal(18, 2)
  currency          Currency
  /// UTC instant of the user-entered local date and time (converted in the
  /// user's IANA timezone by the action layer); rendered back in that zone.
  /// The user enters both a day and a time of day
  /// (`lib/datetime/local-date-time.ts`), and only the action layer knows the
  /// session user's zone, so only it can pin that wall-clock moment to an
  /// instant. Period math uses `getPeriodBounds` in the same zone, and the
  /// lists render it with `formatInTimeZone(date, timezone, 'yyyy-MM-dd HH:mm')`.
  date              DateTime
  note              String?
  /// Decimal(18, 6) — deliberately the same scale as `ExchangeRate.rate`, so
  /// the snapshot is the cached rate to the digit rather than a value rounded
  /// on the way in. At Decimal(18, 4) a transaction could not be reconciled
  /// against the rate it was actually recorded with.
  vndPerUsdAtEntry  Decimal         @db.Decimal(18, 6)
  /// When we retrieved the rate. On the fallback path this is the ORIGINAL
  /// fetch instant preserved by `getUsableCurrentRate`, never "now".
  fxRateFetchedAt   DateTime
  /// Start of the UTC day the rate is effective for — the `ExchangeRate`
  /// cache key, so a snapshot can be traced back to the exact cached row.
  fxRateEffectiveAt DateTime
  fxRateSource      String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  account  FinancialAccount @relation(fields: [userId, accountId], references: [userId, id])
  category Category?        @relation(fields: [userId, categoryId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, date])
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
}

/// An internal move of money between two of the user's own accounts (§4.5).
///
/// A transfer is its own entity, never a pair of transactions: it has no
/// category, never appears as income or expense in any report, and carries no
/// FX snapshot — the only rate that matters here is the one actually applied
/// between the two accounts, stored as `exchangeRateUsed`.
///
/// `exchangeRateUsed` is NULL for a same-currency transfer, where `toAmount`
/// is derived from `fromAmount` server-side and money is conserved by
/// construction. For a cross-currency transfer it is `toAmount / fromAmount`,
/// the effective rate the user actually got, kept for the audit trail.
///
/// Both legs are composite `(userId, accountId)` foreign keys, so neither end
/// of a transfer can ever point at another user's account. Positivity of both
/// amounts is enforced by database CHECK constraints
/// (`Transfer_fromAmount_positive`, `Transfer_toAmount_positive`) added by
/// hand in this model's migration, since Prisma has no CHECK syntax.
model Transfer {
  id               String   @id @default(cuid())
  userId           String
  fromAccountId    String
  toAccountId      String
  fromAmount       Decimal  @db.Decimal(18, 2)
  toAmount         Decimal  @db.Decimal(18, 2)
  /// Widened from Decimal(18,6) to Decimal(24,12) (ruling R-19): a
  /// cross-currency rate can need more than 6 fractional digits to round-trip
  /// exactly (e.g. a very small or very large effective rate), and 6 was
  /// already tight for VND, whose unit amounts are large. 12 fractional
  /// digits plus 12 integer digits comfortably covers every rate this app can
  /// produce from two Decimal(18,2) amounts.
  exchangeRateUsed Decimal? @db.Decimal(24, 12)
  /// Same convention as `Transaction.date`: the UTC instant of the
  /// user-entered local date and time (converted in the user's IANA timezone
  /// by the action layer); rendered back in that zone. Period math uses
  /// `getPeriodBounds` in the same zone.
  date             DateTime
  note             String?
  createdAt        DateTime @default(now())

  fromAccount FinancialAccount @relation("TransferFromAccount", fields: [userId, fromAccountId], references: [userId, id])
  toAccount   FinancialAccount @relation("TransferToAccount", fields: [userId, toAccountId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, date])
}

enum BudgetScope {
  OVERALL
  CATEGORY
}

/// A monthly spending target (spec §4.6). Tracking only: it never moves money.
/// `year`/`month` are plain integers — a budget's identity ("March 2026") needs
/// no timezone; only the query that sums that month's EXPENSE rows does
/// (`getCalendarMonthBounds`). `amount` is denominated in `currency`, and
/// progress is summed into that same currency via `historicalAmountIn`.
/// Uniqueness ("one OVERALL per month", "one per category per month") lives in
/// two PARTIAL unique indexes written by hand in this model's migration —
/// a plain @@unique cannot express it because NULL categoryId values are
/// distinct from each other in Postgres.
///
/// Three further invariants are database CHECK constraints in that same
/// migration, since Prisma's schema language has no CHECK syntax:
/// `Budget_month_range` (1–12), `Budget_amount_positive` (> 0) and
/// `Budget_scope_category_consistent` (a CATEGORY budget names a category, an
/// OVERALL budget does not).
model Budget {
  id         String      @id @default(cuid())
  userId     String
  year       Int
  month      Int
  scope      BudgetScope
  categoryId String?
  amount     Decimal     @db.Decimal(18, 2)
  currency   Currency
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  category Category? @relation(fields: [userId, categoryId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, year, month])
}

enum SavingsGoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

/// A manual savings target (spec §4.8). Tracking only — `currentProgress` is
/// typed in by the user and is never derived from, or written to, any account.
/// Nothing in `lib/server/services/savings-goal.ts` creates a Transaction or a
/// Transfer, so a goal reaching its target moves no money and changes no
/// balance; the two are related only in the user's head.
///
/// ACHIEVED is recomputed from progress >= target on every write (spec §5,
/// "never store what can drift") rather than being a state the user sets, so
/// raising a target past what is already saved reverts the goal to ACTIVE on
/// its own. ARCHIVED is the one stored human decision, and it is terminal: an
/// archived goal refuses further edits (`SavingsGoalArchivedError`).
///
/// `deadline` is a calendar date, not an instant: it is stored as the UTC
/// midnight of the chosen day — a carrier — and never re-projected through a
/// timezone. See `lib/datetime/calendar-date.ts` (ruling R6-7).
///
/// `currency` is the goal's own, and `User.baseCurrency` never rewrites it
/// (ledger ruling R5-3): the page renders each goal in the currency it was set
/// in. Two invariants are database CHECK constraints in this model's migration,
/// since Prisma's schema language has no CHECK syntax:
/// `SavingsGoal_targetAmount_positive` (> 0) and
/// `SavingsGoal_currentProgress_nonnegative` (>= 0). There is deliberately no
/// `currentProgress <= targetAmount` CHECK — over-saving is a real thing that
/// happens, and the UI clamps only the progress *bar*.
model SavingsGoal {
  id              String            @id @default(cuid())
  userId          String
  name            String
  targetAmount    Decimal           @db.Decimal(18, 2)
  currentProgress Decimal           @db.Decimal(18, 2) @default(0)
  currency        Currency
  deadline        DateTime?
  note            String?
  status          SavingsGoalStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, id])
  @@index([userId, status])
}

enum DebtDirection {
  RECEIVABLE
  PAYABLE
}

/// Stored status is deliberately only ACTIVE | WRITTEN_OFF. OPEN,
/// PARTIALLY_PAID, PAID and OVERDUE are all computable from the derived
/// outstanding amount and the due date, and storing any of them would let them
/// drift the moment a payment is recorded or a due date passes (spec §5,
/// "never store what can drift"). Writing a debt off is the one genuine human
/// decision here — "I am never getting this back" is not derivable from any
/// figure — so it is the one thing stored.
enum DebtStoredStatus {
  ACTIVE
  WRITTEN_OFF
}

/// Money someone owes the user (RECEIVABLE) or the user owes someone else
/// (PAYABLE), spec §4.9. Tracking only: there is no foreign key and no code
/// path from here to FinancialAccount or Transaction, so recording a repayment
/// changes no balance — `lib/server/services/debt.ts` imports nothing that
/// could, and `debt.test.ts` re-asserts the account counts and a derived
/// balance after every mutation.
///
/// The outstanding amount is never stored: it is `originalAmount` minus the sum
/// of this debt's `DebtPayment` rows, computed in `debt.ts`
/// (`deriveDebtOutstanding`). A stored copy would be a second source of truth
/// that a failed write, a deleted payment or a concurrent request could put out
/// of step with the payments themselves.
///
/// `direction`, `originalAmount` and `currency` are immutable after creation
/// (see `lib/validation/debt.ts`): they define *which* debt this is, and
/// changing one after payments exist would rewrite history rather than correct
/// it. Editing covers `person`, `description`, `dueDate` and `notes`.
///
/// `dueDate` is a calendar date, not an instant: stored as the UTC midnight of
/// the chosen day — a carrier — and never re-projected through a timezone. An
/// overdue check compares `formatCalendarDate(dueDate)` against
/// `todayCalendarDateInZone(user.timezone)`; see `lib/datetime/calendar-date.ts`
/// (ruling R6-7).
///
/// `currency` is the debt's own and `User.baseCurrency` never rewrites it
/// (ledger ruling R5-3). `Debt_originalAmount_positive` (> 0) is a database
/// CHECK constraint in this model's migration, since Prisma's schema language
/// has no CHECK syntax.
model Debt {
  id             String           @id @default(cuid())
  userId         String
  direction      DebtDirection
  person         String
  description    String?
  originalAmount Decimal          @db.Decimal(18, 2)
  currency       Currency
  /// Calendar date, stored as its UTC-midnight carrier (ruling R6-7).
  dueDate        DateTime?
  status         DebtStoredStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  payments DebtPayment[]

  @@unique([userId, id])
  @@index([userId, status])
}

/// One repayment recorded against a Debt (spec §4.9). It inherits the debt's
/// currency — there are no cross-currency debt payments in the MVP, so a
/// payment carries no currency column of its own and no FX snapshot.
///
/// The composite `(userId, debtId)` foreign key is what makes cross-tenant
/// reference impossible at the database level: a payment can never point at
/// another user's debt (spec §4.12), and an attempt raises P2003 even when it
/// bypasses the service.
///
/// `date` is a calendar date carrier, like `Debt.dueDate` — "I was paid back on
/// the 12th" names a day, not a moment. `DebtPayment_amount_positive` (> 0) is
/// a database CHECK constraint in this model's migration.
model DebtPayment {
  id        String   @id @default(cuid())
  userId    String
  debtId    String
  amount    Decimal  @db.Decimal(18, 2)
  /// Calendar date, stored as its UTC-midnight carrier (ruling R6-7).
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  debt Debt @relation(fields: [userId, debtId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, debtId, date])
}

/// Stored status is deliberately only ACTIVE | CLOSED. PAID_OFF and OVERDUE are
/// both computable — from the derived outstanding principal and from
/// `nextDueDate` against the user's today — and storing either would let it
/// drift the moment a payment lands or a day passes (spec §5, "never store what
/// can drift"). Closing a loan is the one genuine human decision here ("this
/// agreement is finished", whether it was repaid, refinanced or forgiven), so it
/// is the one thing stored — and it is terminal.
enum LoanStoredStatus {
  ACTIVE
  CLOSED
}

/// How often an instalment falls due. The advancement arithmetic for each lives
/// in `lib/datetime/add-months-clamped.ts` (`advanceByFrequency`), whose
/// `PaymentFrequency` union mirrors this enum by hand so the browser bundle
/// never pulls in the Prisma client.
enum PaymentFrequency {
  WEEKLY
  MONTHLY
  YEARLY
}

/// A loan the user owes (spec §4.10). Tracking only: there is no foreign key and
/// no code path from here to FinancialAccount or Transaction, so recording an
/// instalment changes no balance — `lib/server/services/loan.ts` imports nothing
/// that could, and `loan.test.ts` re-asserts the account counts and a derived
/// balance after every mutation.
///
/// Outstanding principal is never stored: it is `principal` minus the sum of
/// this loan's `LoanPayment.principalAmount` values, computed in `loan.ts`
/// (`deriveLoanOutstandingPrincipal`). A stored copy would be a second source of
/// truth that a rolled-back write, a deleted payment or a concurrent request
/// could put out of step with the payment rows themselves.
///
/// `dueDayOfMonth` is the schedule's anchor: the day the user's instalments fall
/// on, captured from the first `nextDueDate`, so a loan due on the 31st goes
/// Jan 31 → Feb 28 → Mar 31 instead of drifting to the 28th for good (ruling
/// R6-6a). It is ignored for a WEEKLY loan, which has no day of the month.
///
/// `interestRate` is percent per year and purely informational: nothing in this
/// app computes interest or an amortisation schedule from it — the user reads
/// their instalment off their own loan statement and types the principal and
/// interest parts in. Storing it makes the loan's own terms visible next to its
/// history; deriving anything from it would be inventing figures the bank did
/// not charge.
///
/// `principal`, `currency`, `startDate`, `termMonths`, `paymentFrequency` and
/// `interestRate` are immutable after creation (see `lib/validation/loan.ts`):
/// they define *which* loan this is, and changing one after payments exist would
/// re-interpret that history against terms the loan never had. Editing covers
/// `lender`, `scheduledPaymentAmount` and `notes`.
///
/// `startDate` and `nextDueDate` are calendar dates, not instants: stored as the
/// UTC midnight of the chosen day — carriers — and never re-projected through a
/// timezone (ruling R6-7, `lib/datetime/calendar-date.ts`). An overdue check
/// compares `formatCalendarDate(nextDueDate)` against
/// `todayCalendarDateInZone(user.timezone)`.
///
/// `currency` is the loan's own and `User.baseCurrency` never rewrites it
/// (ledger ruling R5-3). Five invariants are database CHECK constraints in this
/// model's migration, since Prisma's schema language has no CHECK syntax:
/// `Loan_principal_positive` (> 0), `Loan_interestRate_nonnegative` (>= 0),
/// `Loan_termMonths_positive` (> 0), `Loan_scheduledPaymentAmount_positive`
/// (> 0) and `Loan_dueDayOfMonth_range` (1–31).
model Loan {
  id                     String           @id @default(cuid())
  userId                 String
  lender                 String
  principal              Decimal          @db.Decimal(18, 2)
  currency               Currency
  /// Percent per year, informational only — no interest is ever computed here.
  interestRate           Decimal          @db.Decimal(6, 3)
  /// Calendar date, stored as its UTC-midnight carrier (ruling R6-7).
  startDate              DateTime
  termMonths             Int
  paymentFrequency       PaymentFrequency
  scheduledPaymentAmount Decimal          @db.Decimal(18, 2)
  /// Calendar date, stored as its UTC-midnight carrier (ruling R6-7). Advanced
  /// by exactly one interval inside the same transaction as each payment.
  nextDueDate            DateTime
  /// The schedule's anchor day, 1–31, captured from the first `nextDueDate`.
  dueDayOfMonth          Int
  status                 LoanStoredStatus @default(ACTIVE)
  notes                  String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  payments LoanPayment[]

  @@unique([userId, id])
  @@index([userId, status])
}

/// One instalment recorded against a Loan (spec §4.10). It inherits the loan's
/// currency — there are no cross-currency loan payments in the MVP, so a payment
/// carries no currency column of its own and no FX snapshot.
///
/// `totalAmount = principalAmount + interestAmount`, enforced three times over:
/// by Zod before the request is trusted (`lib/validation/loan.ts`), by a
/// `Prisma.Decimal` re-check inside the locked transaction, and by the
/// `LoanPayment_total_matches_split` CHECK in this model's migration. Only
/// `principalAmount` reduces the outstanding principal; interest is the cost of
/// the loan and reduces nothing. An interest-only instalment
/// (`principalAmount = 0`) is legitimate and accepted (ruling R6-6), so the
/// CHECKs are `principalAmount >= 0`, `interestAmount >= 0` and
/// `totalAmount > 0`.
///
/// The composite `(userId, loanId)` foreign key is what makes cross-tenant
/// reference impossible at the database level: a payment can never point at
/// another user's loan (spec §4.12), and an attempt raises P2003 even when it
/// bypasses the service.
model LoanPayment {
  id              String   @id @default(cuid())
  userId          String
  loanId          String
  totalAmount     Decimal  @db.Decimal(18, 2)
  principalAmount Decimal  @db.Decimal(18, 2)
  interestAmount  Decimal  @db.Decimal(18, 2)
  /// Calendar date, stored as its UTC-midnight carrier (ruling R6-7).
  paymentDate     DateTime
  note            String?
  createdAt       DateTime @default(now())

  loan Loan @relation(fields: [userId, loanId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, loanId, paymentDate])
}

/// Whether a reminder is money coming in or going out. Mirrors `CategoryType`
/// value for value on purpose: a reminder's `type` is what a linked `Category`
/// has to match (`reminder.ts` refuses an INCOME category on an EXPENSE
/// reminder), so a divergence between the two enums would make that check
/// meaningless. It is a separate enum rather than a reuse because the two
/// concepts are separate — a later phase adding a transfer-shaped reminder
/// would widen this one and must not widen categories.
enum ReminderType {
  INCOME
  EXPENSE
}

/// How often a reminder recurs. ONE_TIME is a member rather than a null
/// `frequency` so "remind me once, on the 14th" is a first-class schedule
/// instead of a special case every query has to remember to handle — and it is
/// the one frequency whose backfill window is never clamped (directive O; see
/// `lib/server/services/recurrence.ts`).
///
/// `lib/server/services/recurrence.ts` mirrors this enum by hand as a string
/// union so the recurrence arithmetic stays free of a Prisma import, exactly as
/// `PaymentFrequency` is mirrored in `lib/datetime/add-months-clamped.ts`.
enum RecurrenceFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  YEARLY
}

/// What the user has done about one due instance. PENDING is the only state
/// materialization ever writes; the other two are the user's own answer to
/// "have you dealt with this?".
///
/// "Overdue" is deliberately **not** a member: it is `dueAt < now && status =
/// PENDING`, a derived display flag, and storing it would need a background job
/// to keep it true and would be wrong for every reader in a different timezone
/// (spec §4.7, §5 "never store what can drift").
enum OccurrenceStatus {
  PENDING
  ACKNOWLEDGED
  DISMISSED
}

/// A recurring financial reminder or bill (spec §4.7). Never a Transaction: when
/// an occurrence is due it is shown in-app, and acknowledging or dismissing it
/// changes only the occurrence. `startDate` is the instant of LOCAL midnight on
/// the chosen day in `timezone` — the zone recorded on this row, not whatever
/// the user's profile says today (ruling R6-22) — and every `dueAt` is likewise
/// a local midnight in it, so "due on the 1st" means the 1st where the user
/// lived when they set the reminder up.
///
/// This one model is both of the product spec's "Recurring Financial Reminders"
/// and "Bill Reminders": read side by side they describe the same mechanism, and
/// Bills is the `type = EXPENSE` view of it (spec §4.7's design decision).
///
/// Tracking only, like `Debt` and `Loan`: there is no foreign key and no code
/// path from here to `Transaction` or `Transfer`, so no reminder can ever move
/// money. `accountId` is which account the user *expects* to pay from — a label
/// on the reminder, not a link that debits anything — and
/// `lib/server/services/reminder.ts` imports nothing that could write to a
/// ledger (`reminder.test.ts` proves the absence both structurally and
/// behaviourally).
///
/// `categoryId` and `accountId` are optional and carry composite
/// `(userId, categoryId)` / `(userId, accountId)` foreign keys, so a reminder can
/// never reference another user's category or account (spec §4.12) — an attempt
/// raises P2003 even when the service is bypassed. `reminder.ts` additionally
/// requires a linked category's `type` to match the reminder's and a linked
/// account to be ACTIVE *at creation*; neither is re-checked later, because
/// archiving a category must not freeze the reminders filed under it (the same
/// rule `transaction.ts` applies).
///
/// `dayOfMonth` is the schedule's anchor day and is clamped down to each target
/// month's length, so 31 means "the 31st, or the last day of a shorter month"
/// and a reminder due at month end never decays to the 28th (ruling R6-6a's
/// reasoning, applied here through `lib/datetime/add-months-clamped.ts`).
/// `month` is 1–12 and is the YEARLY anchor month only; both are NULL for
/// WEEKLY and ONE_TIME, where they would have no meaning.
///
/// `active` is a switch, not a status enum: pausing a reminder stops
/// materialization producing new occurrences and nothing else — the ones already
/// materialized stay exactly as they are, because they really were due.
///
/// `currency` is the reminder's own and `User.baseCurrency` never rewrites it
/// (ledger ruling R5-3). Four invariants are database CHECK constraints in this
/// model's migration, since Prisma's schema language has no CHECK syntax:
/// `RecurringReminder_expectedAmount_positive` (> 0),
/// `RecurringReminder_interval_min` (>= 1),
/// `RecurringReminder_dayOfMonth_range` (NULL or 1–31) and
/// `RecurringReminder_month_range` (NULL or 1–12).
model RecurringReminder {
  id             String              @id @default(cuid())
  userId         String
  title          String
  type           ReminderType
  expectedAmount Decimal             @db.Decimal(18, 2)
  currency       Currency
  categoryId     String?
  accountId      String?
  frequency      RecurrenceFrequency
  interval       Int                 @default(1)
  /// The anchor day 1–31, clamped to each month's length. MONTHLY/YEARLY only.
  dayOfMonth     Int?
  /// The anchor month 1–12 (not JavaScript's 0–11). YEARLY only.
  month          Int?
  /// The instant of LOCAL midnight on the first day the reminder can fall on,
  /// in `timezone` below — never in the viewer's current zone.
  startDate      DateTime
  /// The IANA zone this schedule is anchored to — the user's zone at the moment
  /// the reminder was created, e.g. `"Asia/Ho_Chi_Minh"`.
  ///
  /// Recorded on the row instead of read from `User.timezone` on each pass
  /// because `User.timezone` is editable (ruling R6-22). Materialization derives
  /// the local start day from `startDate` and writes each `dueAt` as local
  /// midnight, so doing that in the *request's* zone would re-phase every
  /// existing series the moment the profile changed: a monthly reminder stored
  /// at `2025-12-31T17:00Z` reads as 31 December in `America/New_York`, and the
  /// new `dueAt`s would be different instants from the stored ones — which
  /// `@@unique([reminderId, dueAt])` cannot dedupe, leaving two PENDING rows for
  /// one bill. A later profile change therefore never moves an existing series;
  /// only *display* follows the viewer, and every page renders `dueAt` and
  /// `startDate` in whatever zone the viewer is in now.
  timezone       String
  note           String?
  active         Boolean             @default(true)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  category    Category?            @relation(fields: [userId, categoryId], references: [userId, id])
  account     FinancialAccount?    @relation(fields: [userId, accountId], references: [userId, id])
  occurrences ReminderOccurrence[]

  @@unique([userId, id])
  @@index([userId, active])
}

/// One due instance, materialized lazily on read. `@@unique([reminderId, dueAt])`
/// is what makes materialization idempotent under repeated and concurrent reads.
///
/// There is no cron and no background job (spec §4.7): reading the Reminders page
/// or the dashboard widget computes each active reminder's due dates for a window
/// around today and inserts the missing rows with
/// `createMany({ skipDuplicates: true })`. The unique index is therefore not a
/// safety net over an application check — it *is* the check, which is why two
/// requests arriving at the same moment cannot produce a duplicate however they
/// interleave.
///
/// Materialization only ever inserts. It never updates an existing row, so an
/// ACKNOWLEDGED or DISMISSED occurrence can never be resurrected as PENDING by a
/// later read — the property `reminder.test.ts` pins down directly.
///
/// `dueAt` is the instant of LOCAL midnight of the day the occurrence falls on,
/// in the user's timezone (17:00Z the previous day for `Asia/Ho_Chi_Minh`), so
/// "due on the 1st" is the 1st where the user lives. It is *not* a calendar-date
/// carrier: unlike a debt's due date, an occurrence is compared against `now` to
/// decide whether it is overdue, and that comparison has to be between two real
/// instants.
///
/// The composite `(userId, reminderId)` foreign key is what makes cross-tenant
/// reference impossible at the database level: an occurrence can never point at
/// another user's reminder (spec §4.12), and an attempt raises P2003 even when it
/// bypasses the service.
model ReminderOccurrence {
  id         String           @id @default(cuid())
  userId     String
  reminderId String
  /// The instant of LOCAL midnight of the day this occurrence is due.
  dueAt      DateTime
  status     OccurrenceStatus @default(PENDING)
  actionedAt DateTime?
  createdAt  DateTime         @default(now())

  reminder RecurringReminder @relation(fields: [userId, reminderId], references: [userId, id])

  @@unique([reminderId, dueAt])
  @@unique([userId, id])
  @@index([userId, status, dueAt])
}
