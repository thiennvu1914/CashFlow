// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth tables.
//
// Started from `npx @better-auth/cli@latest generate`, then reconciled by hand
// against the installed better-auth 1.7.2's own table definitions
// (`getAuthTables` in @better-auth/core/db). The published CLI is 1.4.21 and
// lags the library, so its output was missing `Account.issuer` and the
// `(issuer, accountId)` unique index.
//
// better-auth leaves an additional field's `required` unset, so the CLI emitted
// the five CashFlow user fields as nullable. CashFlow deliberately makes those
// five columns NOT NULL with database defaults instead: the app treats them as
// always-present settings, and a database default keeps that true for every
// writer, not just Better Auth's own create path.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // CashFlow's additional user fields. Better Auth applies these same defaults
  // when it creates the row; the database defaults cover every other writer.
  // All five are `input: false` in `lib/auth/create-auth.ts`, so no client
  // request body can set them. The four profile values below are the DB-level
  // copy of `USER_FIELD_DEFAULTS` in `lib/auth/user-defaults.ts` — the single
  // source the application code shares; keep them in step.
  baseCurrency  String    @default("VND")
  locale        String    @default("vi")
  theme         String    @default("light")
  timezone      String    @default("Asia/Ho_Chi_Minh")
  isDemo        Boolean   @default(false)
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// Better Auth's own OAuth / credential-linking table — NOT the financial
/// account concept. Phase 2 introduces `FinancialAccount` precisely to avoid
/// colliding with this name (§3, §4.3 of the spec). Do not rename this model.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// CashFlow domain tables.
//
// Neither model below declares a back-relation array yet (no
// `accounts FinancialAccount[]` on AccountType, no `transactions Transaction[]`
// on Category): the models those would point at do not exist. The phase's later
// tasks add the one-line back-relation in the same commit that introduces the
// referencing model, which keeps every migration valid on its own.
//
// The `@@unique([userId, id])` on each is what lets later models carry a
// composite `(userId, <fk>)` foreign key, so a row can never reference another
// user's AccountType or Category (§4.12 of the spec).
// ---------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryType {
  INCOME
  EXPENSE
}

model AccountType {
  id        String       @id @default(cuid())
  userId    String
  name      String
  icon      String?
  isDefault Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  accounts FinancialAccount[]

  @@unique([userId, id])
  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  isDefault Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  @@unique([userId, id])
  @@index([userId])
}

enum Currency {
  VND
  USD
}

model FinancialAccount {
  id             String       @id @default(cuid())
  userId         String
  name           String
  accountTypeId  String
  initialBalance Decimal      @db.Decimal(18, 2)
  currency       Currency
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  accountType AccountType @relation(fields: [userId, accountTypeId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId])
}
