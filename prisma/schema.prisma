// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Better Auth tables.
//
// Started from `npx @better-auth/cli@latest generate`, then reconciled by hand
// against the installed better-auth 1.7.2's own table definitions
// (`getAuthTables` in @better-auth/core/db). The published CLI is 1.4.21 and
// lags the library, so its output was missing `Account.issuer` and the
// `(issuer, accountId)` unique index.
//
// better-auth leaves an additional field's `required` unset, so the CLI emitted
// the five CashFlow user fields as nullable. CashFlow deliberately makes those
// five columns NOT NULL with database defaults instead: the app treats them as
// always-present settings, and a database default keeps that true for every
// writer, not just Better Auth's own create path.
// ---------------------------------------------------------------------------

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  // CashFlow's additional user fields. Better Auth applies these same defaults
  // when it creates the row; the database defaults cover every other writer.
  // All five are `input: false` in `lib/auth/create-auth.ts`, so no client
  // request body can set them. The four profile values below are the DB-level
  // copy of `USER_FIELD_DEFAULTS` in `lib/auth/user-defaults.ts` — the single
  // source the application code shares; keep them in step.
  baseCurrency  String    @default("VND")
  locale        String    @default("vi")
  theme         String    @default("light")
  timezone      String    @default("Asia/Ho_Chi_Minh")
  isDemo        Boolean   @default(false)
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

/// Better Auth's own OAuth / credential-linking table — NOT the financial
/// account concept. Phase 2 introduces `FinancialAccount` precisely to avoid
/// colliding with this name (§3, §4.3 of the spec). Do not rename this model.
model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// CashFlow domain tables.
//
// A back-relation array is added to a model only in the same commit that
// introduces the model referencing it, which keeps every migration valid on its
// own. `AccountType.accounts` arrived with `FinancialAccount`, and
// `Category.transactions` / `FinancialAccount.transactions` with `Transaction`.
//
// The `@@unique([userId, id])` on each is what lets later models carry a
// composite `(userId, <fk>)` foreign key, so a row can never reference another
// user's AccountType or Category (§4.12 of the spec).
// ---------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  ARCHIVED
}

enum CategoryType {
  INCOME
  EXPENSE
}

model AccountType {
  id        String       @id @default(cuid())
  userId    String
  name      String
  icon      String?
  isDefault Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  accounts FinancialAccount[]

  @@unique([userId, id])
  @@index([userId])
}

model Category {
  id        String       @id @default(cuid())
  userId    String
  name      String
  type      CategoryType
  icon      String?
  isDefault Boolean      @default(false)
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now())

  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, id])
  @@index([userId])
}

enum Currency {
  VND
  USD
}

model FinancialAccount {
  id             String       @id @default(cuid())
  userId         String
  name           String
  accountTypeId  String
  initialBalance Decimal      @db.Decimal(18, 2)
  currency       Currency
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now())

  accountType   AccountType   @relation(fields: [userId, accountTypeId], references: [userId, id])
  transactions  Transaction[]
  transfersFrom Transfer[]    @relation("TransferFromAccount")
  transfersTo   Transfer[]    @relation("TransferToAccount")

  @@unique([userId, id])
  @@index([userId])
}

/// FX rate cache (§6.2). Global, not per-user: a USD/VND rate for a given day
/// is the same fact for everyone, so this table carries no `userId` and is the
/// one CashFlow table not scoped by `requireUser()`.
///
/// `effectiveDate` is always the UTC start-of-day the rate applies to, which is
/// what makes `(base, quote, effectiveDate)` a natural key: one cached row per
/// pair per day, upserted when a fresher fetch for the same day arrives.
/// Historical rows are kept permanently — a past day's rate never changes.
model ExchangeRate {
  id            String   @id @default(cuid())
  base          Currency
  quote         Currency
  rate          Decimal  @db.Decimal(18, 6)
  effectiveDate DateTime
  fetchedAt     DateTime
  source        String

  @@unique([base, quote, effectiveDate])
  @@index([base, quote, effectiveDate(sort: Desc)])
}

enum TransactionType {
  INCOME
  EXPENSE
  CASH_IN
  CASH_OUT
  ADJUSTMENT_INCREASE
  ADJUSTMENT_DECREASE
}

/// A single money movement (§4.4). `amount` is always >= 0 — the direction is
/// carried by `type` alone, never by the sign — and `currency` is always a copy
/// of the owning account's currency, never client-supplied.
///
/// The four `fx*` columns are the immutable FX snapshot: the usable USD/VND
/// rate at the moment this transaction's economic content was recorded, taken
/// only from `getUsableCurrentRate`. The pair is always USD/VND regardless of
/// the account currency, so any later report can restate the row in either
/// currency using the rate that actually applied.
///
/// The two timestamps answer two different questions and are both kept:
/// `fxRateEffectiveAt` is *when the rate applies* — the UTC start of the day
/// it was published for, which is the `ExchangeRate` cache's natural key — and
/// `fxRateFetchedAt` is *when we retrieved it*. They can be a day or more
/// apart: on the fallback path both are the original cached row's own values,
/// never "now", so a snapshot recorded during an outage still says honestly
/// which day's rate it used and when that rate was obtained. `fxRateSource`
/// carries the `cache-fallback:` prefix in exactly that case.
///
/// The `category` relation is optional while still being a composite FK: under
/// Postgres's default MATCH SIMPLE semantics a NULL in any column of a
/// composite FK exempts the row from the constraint check, so CASH_IN /
/// CASH_OUT / ADJUSTMENT_* rows with no category are unaffected.
model Transaction {
  id                String          @id @default(cuid())
  userId            String
  accountId         String
  categoryId        String?
  type              TransactionType
  /// >= 0 is also enforced by a database CHECK constraint
  /// (`Transaction_amount_nonnegative`), written by hand in the
  /// `add_transfer` migration — Prisma's schema language has no CHECK syntax,
  /// so the constraint lives in SQL and this comment is its only trace here.
  amount            Decimal         @db.Decimal(18, 2)
  currency          Currency
  /// UTC instant of the user-entered local date and time (converted in the
  /// user's IANA timezone by the action layer); rendered back in that zone.
  /// The user enters both a day and a time of day
  /// (`lib/datetime/local-date-time.ts`), and only the action layer knows the
  /// session user's zone, so only it can pin that wall-clock moment to an
  /// instant. Period math uses `getPeriodBounds` in the same zone, and the
  /// lists render it with `formatInTimeZone(date, timezone, 'yyyy-MM-dd HH:mm')`.
  date              DateTime
  note              String?
  /// Decimal(18, 6) — deliberately the same scale as `ExchangeRate.rate`, so
  /// the snapshot is the cached rate to the digit rather than a value rounded
  /// on the way in. At Decimal(18, 4) a transaction could not be reconciled
  /// against the rate it was actually recorded with.
  vndPerUsdAtEntry  Decimal         @db.Decimal(18, 6)
  /// When we retrieved the rate. On the fallback path this is the ORIGINAL
  /// fetch instant preserved by `getUsableCurrentRate`, never "now".
  fxRateFetchedAt   DateTime
  /// Start of the UTC day the rate is effective for — the `ExchangeRate`
  /// cache key, so a snapshot can be traced back to the exact cached row.
  fxRateEffectiveAt DateTime
  fxRateSource      String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  account  FinancialAccount @relation(fields: [userId, accountId], references: [userId, id])
  category Category?        @relation(fields: [userId, categoryId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, date])
  @@index([userId, accountId, date])
  @@index([userId, categoryId, date])
}

/// An internal move of money between two of the user's own accounts (§4.5).
///
/// A transfer is its own entity, never a pair of transactions: it has no
/// category, never appears as income or expense in any report, and carries no
/// FX snapshot — the only rate that matters here is the one actually applied
/// between the two accounts, stored as `exchangeRateUsed`.
///
/// `exchangeRateUsed` is NULL for a same-currency transfer, where `toAmount`
/// is derived from `fromAmount` server-side and money is conserved by
/// construction. For a cross-currency transfer it is `toAmount / fromAmount`,
/// the effective rate the user actually got, kept for the audit trail.
///
/// Both legs are composite `(userId, accountId)` foreign keys, so neither end
/// of a transfer can ever point at another user's account. Positivity of both
/// amounts is enforced by database CHECK constraints
/// (`Transfer_fromAmount_positive`, `Transfer_toAmount_positive`) added by
/// hand in this model's migration, since Prisma has no CHECK syntax.
model Transfer {
  id               String   @id @default(cuid())
  userId           String
  fromAccountId    String
  toAccountId      String
  fromAmount       Decimal  @db.Decimal(18, 2)
  toAmount         Decimal  @db.Decimal(18, 2)
  /// Widened from Decimal(18,6) to Decimal(24,12) (ruling R-19): a
  /// cross-currency rate can need more than 6 fractional digits to round-trip
  /// exactly (e.g. a very small or very large effective rate), and 6 was
  /// already tight for VND, whose unit amounts are large. 12 fractional
  /// digits plus 12 integer digits comfortably covers every rate this app can
  /// produce from two Decimal(18,2) amounts.
  exchangeRateUsed Decimal? @db.Decimal(24, 12)
  /// Same convention as `Transaction.date`: the UTC instant of the
  /// user-entered local date and time (converted in the user's IANA timezone
  /// by the action layer); rendered back in that zone. Period math uses
  /// `getPeriodBounds` in the same zone.
  date             DateTime
  note             String?
  createdAt        DateTime @default(now())

  fromAccount FinancialAccount @relation("TransferFromAccount", fields: [userId, fromAccountId], references: [userId, id])
  toAccount   FinancialAccount @relation("TransferToAccount", fields: [userId, toAccountId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, date])
}

enum BudgetScope {
  OVERALL
  CATEGORY
}

/// A monthly spending target (spec §4.6). Tracking only: it never moves money.
/// `year`/`month` are plain integers — a budget's identity ("March 2026") needs
/// no timezone; only the query that sums that month's EXPENSE rows does
/// (`getCalendarMonthBounds`). `amount` is denominated in `currency`, and
/// progress is summed into that same currency via `historicalAmountIn`.
/// Uniqueness ("one OVERALL per month", "one per category per month") lives in
/// two PARTIAL unique indexes written by hand in this model's migration —
/// a plain @@unique cannot express it because NULL categoryId values are
/// distinct from each other in Postgres.
///
/// Three further invariants are database CHECK constraints in that same
/// migration, since Prisma's schema language has no CHECK syntax:
/// `Budget_month_range` (1–12), `Budget_amount_positive` (> 0) and
/// `Budget_scope_category_consistent` (a CATEGORY budget names a category, an
/// OVERALL budget does not).
model Budget {
  id         String      @id @default(cuid())
  userId     String
  year       Int
  month      Int
  scope      BudgetScope
  categoryId String?
  amount     Decimal     @db.Decimal(18, 2)
  currency   Currency
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  category Category? @relation(fields: [userId, categoryId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, year, month])
}

enum SavingsGoalStatus {
  ACTIVE
  ACHIEVED
  ARCHIVED
}

/// A manual savings target (spec §4.8). Tracking only — `currentProgress` is
/// typed in by the user and is never derived from, or written to, any account.
/// Nothing in `lib/server/services/savings-goal.ts` creates a Transaction or a
/// Transfer, so a goal reaching its target moves no money and changes no
/// balance; the two are related only in the user's head.
///
/// ACHIEVED is recomputed from progress >= target on every write (spec §5,
/// "never store what can drift") rather than being a state the user sets, so
/// raising a target past what is already saved reverts the goal to ACTIVE on
/// its own. ARCHIVED is the one stored human decision, and it is terminal: an
/// archived goal refuses further edits (`SavingsGoalArchivedError`).
///
/// `deadline` is a calendar date, not an instant: it is stored as the UTC
/// midnight of the chosen day — a carrier — and never re-projected through a
/// timezone. See `lib/datetime/calendar-date.ts` (ruling R6-7).
///
/// `currency` is the goal's own, and `User.baseCurrency` never rewrites it
/// (ledger ruling R5-3): the page renders each goal in the currency it was set
/// in. Two invariants are database CHECK constraints in this model's migration,
/// since Prisma's schema language has no CHECK syntax:
/// `SavingsGoal_targetAmount_positive` (> 0) and
/// `SavingsGoal_currentProgress_nonnegative` (>= 0). There is deliberately no
/// `currentProgress <= targetAmount` CHECK — over-saving is a real thing that
/// happens, and the UI clamps only the progress *bar*.
model SavingsGoal {
  id              String            @id @default(cuid())
  userId          String
  name            String
  targetAmount    Decimal           @db.Decimal(18, 2)
  currentProgress Decimal           @db.Decimal(18, 2) @default(0)
  currency        Currency
  deadline        DateTime?
  note            String?
  status          SavingsGoalStatus @default(ACTIVE)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([userId, id])
  @@index([userId, status])
}

enum DebtDirection {
  RECEIVABLE
  PAYABLE
}

/// Stored status is deliberately only ACTIVE | WRITTEN_OFF. OPEN,
/// PARTIALLY_PAID, PAID and OVERDUE are all computable from the derived
/// outstanding amount and the due date, and storing any of them would let them
/// drift the moment a payment is recorded or a due date passes (spec §5,
/// "never store what can drift"). Writing a debt off is the one genuine human
/// decision here — "I am never getting this back" is not derivable from any
/// figure — so it is the one thing stored.
enum DebtStoredStatus {
  ACTIVE
  WRITTEN_OFF
}

/// Money someone owes the user (RECEIVABLE) or the user owes someone else
/// (PAYABLE), spec §4.9. Tracking only: there is no foreign key and no code
/// path from here to FinancialAccount or Transaction, so recording a repayment
/// changes no balance — `lib/server/services/debt.ts` imports nothing that
/// could, and `debt.test.ts` re-asserts the account counts and a derived
/// balance after every mutation.
///
/// The outstanding amount is never stored: it is `originalAmount` minus the sum
/// of this debt's `DebtPayment` rows, computed in `debt.ts`
/// (`deriveDebtOutstanding`). A stored copy would be a second source of truth
/// that a failed write, a deleted payment or a concurrent request could put out
/// of step with the payments themselves.
///
/// `direction`, `originalAmount` and `currency` are immutable after creation
/// (see `lib/validation/debt.ts`): they define *which* debt this is, and
/// changing one after payments exist would rewrite history rather than correct
/// it. Editing covers `person`, `description`, `dueDate` and `notes`.
///
/// `dueDate` is a calendar date, not an instant: stored as the UTC midnight of
/// the chosen day — a carrier — and never re-projected through a timezone. An
/// overdue check compares `formatCalendarDate(dueDate)` against
/// `todayCalendarDateInZone(user.timezone)`; see `lib/datetime/calendar-date.ts`
/// (ruling R6-7).
///
/// `currency` is the debt's own and `User.baseCurrency` never rewrites it
/// (ledger ruling R5-3). `Debt_originalAmount_positive` (> 0) is a database
/// CHECK constraint in this model's migration, since Prisma's schema language
/// has no CHECK syntax.
model Debt {
  id             String           @id @default(cuid())
  userId         String
  direction      DebtDirection
  person         String
  description    String?
  originalAmount Decimal          @db.Decimal(18, 2)
  currency       Currency
  /// Calendar date, stored as its UTC-midnight carrier (ruling R6-7).
  dueDate        DateTime?
  status         DebtStoredStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  payments DebtPayment[]

  @@unique([userId, id])
  @@index([userId, status])
}

/// One repayment recorded against a Debt (spec §4.9). It inherits the debt's
/// currency — there are no cross-currency debt payments in the MVP, so a
/// payment carries no currency column of its own and no FX snapshot.
///
/// The composite `(userId, debtId)` foreign key is what makes cross-tenant
/// reference impossible at the database level: a payment can never point at
/// another user's debt (spec §4.12), and an attempt raises P2003 even when it
/// bypasses the service.
///
/// `date` is a calendar date carrier, like `Debt.dueDate` — "I was paid back on
/// the 12th" names a day, not a moment. `DebtPayment_amount_positive` (> 0) is
/// a database CHECK constraint in this model's migration.
model DebtPayment {
  id        String   @id @default(cuid())
  userId    String
  debtId    String
  amount    Decimal  @db.Decimal(18, 2)
  /// Calendar date, stored as its UTC-midnight carrier (ruling R6-7).
  date      DateTime
  note      String?
  createdAt DateTime @default(now())

  debt Debt @relation(fields: [userId, debtId], references: [userId, id])

  @@unique([userId, id])
  @@index([userId, debtId, date])
}
