DATABASE_URL="postgresql://cashflow:cashflow_dev_password@localhost:5439/cashflow?schema=public"
BETTER_AUTH_SECRET="replace-with-a-random-32-byte-secret"
BETTER_AUTH_URL="http://localhost:3000"
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="CashFlow <no-reply@example.com>"
ALLOW_DEMO_SEED_IN_PRODUCTION="false"

# Dev and E2E only. When set (and SMTP_HOST is not), outgoing email is appended
# as JSON lines to this file instead of being sent. Playwright sets it to
# e2e/.outbox/emails.jsonl so the reset-password test can read the real link.
# Never used in production: getEmailSender() throws there unless SMTP is
# configured, so a stray value here cannot divert reset tokens to disk.
# EMAIL_OUTBOX_FILE=""

# REQUIRED IN PRODUCTION. Comma-separated CIDRs/IPs of the reverse proxy or CDN
# that sets x-forwarded-for in front of this app, e.g. "10.0.0.0/8,192.0.2.10".
# Rate limiting keys on the client IP, which Better Auth resolves by walking the
# forwarded chain right to left and skipping these hops; without it a spoofed
# header or an appending proxy defeats the limit. Leave empty in local dev.
# TRUSTED_PROXY_CIDRS=""
