# CashFlow environment contract.
#
#   cp .env.example .env    # then generate BETTER_AUTH_SECRET (see below)
#
# `lib/server/env.ts` validates this contract once at server start: in
# production a missing or placeholder value is a fatal error that names the
# variables (never their values); in development it prints a warning and the
# app still boots. Groups below say exactly when each variable is needed.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# TZ — the server/container contract. Period math (weeks, months, budgets,
# reminders) is computed from UTC timestamps in each user's IANA zone
# (`User.timezone`), so the process itself must be UTC: a server on a local
# zone shifts every period boundary. Set it in CI and production.
TZ="UTC"

# NODE_ENV is deliberately NOT listed as something to set by hand. Next manages
# it (`next dev` → development, `next build`/`next start` → production).
# Setting NODE_ENV=production locally turns the warnings above into hard boot
# failures for a machine that has no production configuration.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Required in every environment, including at build time: `next build` imports
# every route module to collect page data and the Prisma client is constructed
# at module scope, so the build needs a reachable database.
DATABASE_URL="postgresql://cashflow:cashflow_dev_password@localhost:5439/cashflow?schema=public"

# ---------------------------------------------------------------------------
# Authentication (Better Auth)
# ---------------------------------------------------------------------------
# BETTER_AUTH_SECRET signs session cookies and password-reset tokens. The value
# below is the placeholder the startup validator rejects by name in production
# (it is public in this repository, so anyone could forge a session with it).
# Generate your own:  openssl rand -base64 32
# Rules: non-blank, at least 32 characters, not this placeholder.
BETTER_AUTH_SECRET="replace-me-with-openssl-rand-base64-32-output-not-this-placeholder"

# REQUIRED IN PRODUCTION. The public origin of this deployment. Without it
# Better Auth derives its base URL from the request, so a forged `Host` header
# can end up inside an emailed password-reset link.
BETTER_AUTH_URL="http://localhost:3000"

# REQUIRED IN PRODUCTION. Comma-separated CIDRs/IPs of the reverse proxy or CDN
# that sets x-forwarded-for in front of this app, e.g. "10.0.0.0/8,192.0.2.10".
# Rate limiting keys on the client IP, which Better Auth resolves by walking the
# forwarded chain right to left and skipping these hops; without it a spoofed
# header or an appending proxy defeats the limit. Leave empty in local dev.
TRUSTED_PROXY_CIDRS=""

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# There is no email fallback in production: getEmailSender() throws rather than
# using the console or the file outbox, because a password-reset link is a
# bearer token. SMTP_PORT must be a positive integer whenever SMTP_HOST is set,
# and SMTP_USER/SMTP_PASSWORD may stay empty for an anonymous relay.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
# REQUIRED IN PRODUCTION. Messages sent without a From address are rejected or
# spam-filed — a silently broken password reset.
EMAIL_FROM="CashFlow <no-reply@example.com>"

# Dev and E2E only. When set (and SMTP_HOST is not), outgoing email is appended
# as JSON lines to this file instead of being sent. Playwright sets it to
# e2e/.outbox/emails.jsonl so the reset-password test can read the real link.
# Never used in production: getEmailSender() throws there unless SMTP is
# configured, so a stray value here cannot divert reset tokens to disk.
# EMAIL_OUTBOX_FILE=""

# ---------------------------------------------------------------------------
# FX (USD/VND exchange rates)
# ---------------------------------------------------------------------------
# No variables. Rates come from open.er-api.com, which needs no API key, and
# every other FX input (staleness window, rounding, the historical snapshot
# policy) is code in `lib/currency/`, not configuration.

# ---------------------------------------------------------------------------
# Testing
# ---------------------------------------------------------------------------
# Vitest only. Database-backed tests write throwaway users, FX rates and
# transactions, so they run against their own database and never DATABASE_URL —
# the suite refuses to start if the two are equal. Created and migrated
# automatically on the first test run; needs Postgres up (`docker compose up -d`).
TEST_DATABASE_URL="postgresql://cashflow:cashflow_dev_password@localhost:5439/cashflow_test"

# Playwright only, and REQUIRED to run it — there is no default. The browser
# tests register real users and write real accounts, transactions and reminders
# through the UI, and nothing cleans them up, so the suite refuses to start
# unless this names its own database: it must differ from DATABASE_URL and its
# name must carry `e2e` or `test`. Created and migrated automatically on the
# first run; needs Postgres up (`docker compose up -d`).
E2E_DATABASE_URL="postgresql://cashflow:cashflow_dev_password@localhost:5439/cashflow_e2e"

# Playwright only, set by `playwright.config.ts` for the dev server it spawns —
# never put it in this file or in a deployed environment. It disables auth rate
# limiting so the suite can sign in repeatedly.
# CASHFLOW_E2E_DISABLE_RATE_LIMIT="1"

# ---------------------------------------------------------------------------
# Demo / maintenance
# ---------------------------------------------------------------------------
# Not enforced yet: no code reads this today. It is reserved for the demo
# seed/clear scripts, whose production guard will consume it. Until those land,
# it grants nothing.
ALLOW_DEMO_SEED_IN_PRODUCTION="false"
